generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma-pbis/client"
}

datasource db {
  provider = "postgresql"
  url      = env("PBIS_DATABASE_URL")
}

model PbisImportRun {
  id         String       @id @default(cuid())
  filename   String
  importedAt DateTime     @default(now())
  rowCount   Int
  status     String
  errorLog   String?      @db.Text
  clients    PbisClient[]
}

model PbisClient {
  shipTo                String   @id                // SHIP_TO (PK)
  compteClientBillTo    String                      // COMPTE_CLIENT_BILL_TO
  soldTo                String                      // SOLD_TO

  // Identité entreprise
  companyName           String                      // RAISON_SOCIALE_SOLDTO
  customerNameShipTo    String?                     // CUSTOMER_NAME_SHIPTO (si différent)

  // Adresse facturation (SOLD_TO)
  street                String                      // STREET_NAME_SOLDTO
  postcode              String                      // POSTCODE_SOLDTO
  city                  String                      // CITY_SOLDTO

  // Adresse installation (SHIP_TO, si différente)
  streetShipTo          String?                     // STREET_NAME_SHIPTO
  postcodeShipTo        String?                     // POSTCODE_SHIPTO
  cityShipTo            String?                     // CITY_SHIPTO

  // Identifiants légaux
  siren                 String                      // SIREN_SHIPTO
  siret                 String                      // SIRET_SHIPTO
  vatNumber             String?                     // VAT_NUMBER (vide à l'import, reconstituable)

  // Contact principal
  contactFirstName      String?                     // FIRSTNAME_CONTACT_PRINCIPAL
  contactLastName       String?                     // LASTNAME_CONTACT_PRINCIPAL
  contactEmail          String?                     // EMAIL_CONTACT_PRINCIPAL
  contactPhone          String?                     // PHONE_CONTACT_PRINCIPAL

  // Données business
  vendeur               String?                     // VENDEUR
  employees             Int?                        // EMPLOYEES
  codeNaf               String?                     // CODE_NAF
  nafDescription        String?                     // NAF Desc
  sectionDescription    String?                     // Section Desc
  plis2024              Int?                        // PLIS_2024
  plis2025              Int?                        // PLIS_2025
  flagPaperless         Boolean  @default(false)    // FLAG_PAPERLESS

  // Agrégats contrats MAA (informationnels)
  contractsCount        Int      @default(1)        // nb de lignes Excel pour ce SHIP_TO
  totalLoyerAnnual      Float?                      // somme TOTAL_LOYER_ANNUAL des contrats

  // Relations
  importRunId           String?
  importRun             PbisImportRun? @relation(fields: [importRunId], references: [id])
  acceptance            PbisAcceptance?
  accessToken           PbisAccessToken?
  leads                 PbisLead[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model PbisAcceptance {
  id                    String     @id @default(cuid())
  clientId              String     @unique
  client                PbisClient @relation(fields: [clientId], references: [shipTo])

  offerCode             String

  // Snapshot entreprise (figé au moment de la commande)
  companyName           String?
  siret                 String?
  vatNumber             String?

  // Snapshot facturation
  billingStreet         String?
  billingPostcode       String?
  billingCity           String?

  // Snapshot contact principal
  contactFirstName      String?
  contactLastName       String?
  contactEmail          String?
  contactPhone          String?
  contactFunction       String?

  // Paramètre de souscription
  receptionEmail        String?
  orderReference        String?

  // Signataire
  signatoryFirstName    String?
  signatoryLastName     String?
  signatoryEmail        String?
  signatoryFunction     String?
  signatoryPower        String?
  signatoryPhone        String?

  cgvAcceptedAt         DateTime?
  privacyAcceptedAt     DateTime?

  yousignProcedureId    String?
  yousignStatus         String?
  signedPdfUrl          String?

  generixRedirectedAt   DateTime?
  formalAgreementStatus String?

  shopifyCustomerId     String?
  shopifyDraftOrderId   String?
  shopifyCheckoutUrl    String?
  paymentStatus         String?
  paidAt                DateTime?

  status                String     @default("draft")

  ipAddress             String?
  userAgent             String?    @db.Text

  acceptedAt            DateTime   @default(now())
  signedAt              DateTime?
  updatedAt             DateTime   @updatedAt
}

model PbisLead {
  id                 String      @id @default(cuid())
  clientId           String?
  client             PbisClient? @relation(fields: [clientId], references: [shipTo])

  offerCode          String

  companyName        String
  siret              String?
  contactFirstName   String
  contactLastName    String
  contactEmail       String
  contactPhone       String?

  invoiceVolume      String?
  accountingSoftware String?
  notes              String?     @db.Text

  status             String      @default("new")

  ipAddress          String?
  userAgent          String?     @db.Text

  createdAt          DateTime    @default(now())
}

model PbisAccessToken {
  token     String     @id @default(uuid())
  clientId  String     @unique
  client    PbisClient @relation(fields: [clientId], references: [shipTo], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String?
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken  String?
  refreshTokenExpires DateTime?
}